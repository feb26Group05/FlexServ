{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "providers-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/providers/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "business-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "business-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "chat-route": {
        "ClusterId": "business-cluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "transaction-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8081"
          }
        }
      },
      "business-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082"
          }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8083"
          }
        }
      }
    }
  }
}
